    out property <string> tray-ready-note: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[146] : "The tray icon is available. Closing this window keeps the app observer running; Quit UI still closes only the app. Windows sign-in registration is still unavailable.";
