import { AppWindow, Page, SourceRow } from "app.slint";

// Standalone source-tool fixture. It is not a product entrypoint or validator.
// Navigation may change local presentation; accepted source rows never change.
export component PreviewWindow inherits AppWindow {
    sources: [
        { view-id: 1, label: "Sample North", host: "north.example.invalid", port: "4460", protocol-choice: 0, protocol-label: "NTS preview", port-label: "NTS-KE port", draft-kind: "Baseline", show-draft-badge: false, change-choice: 0 },
        { view-id: 2, label: "Sample South", host: "south.example.invalid", port: "4460", protocol-choice: 0, protocol-label: "NTS preview", port-label: "NTS-KE port", draft-kind: "Baseline", show-draft-badge: false, change-choice: 0 },
        { view-id: 3, label: "Sample West", host: "west.example.invalid", port: "4460", protocol-choice: 0, protocol-label: "NTS preview", port-label: "NTS-KE port", draft-kind: "Baseline", show-draft-badge: false, change-choice: 0 },
    ];
    host-ready: false;
    selected-source: 1;
    private property <Page> remembered-power-page: Page.status;

    navigate(page) => {
        root.current-page = page;
        if root.power-mode { root.remembered-power-page = page; }
    }
    mode-requested(power) => {
        if !power && root.power-mode {
            root.remembered-power-page = root.current-page;
            if root.current-page == Page.sources || root.current-page == Page.statistics || root.current-page == Page.diagnostics || root.current-page == Page.recovery {
                root.current-page = Page.status;
            }
        }
        if power && !root.power-mode && root.current-page == Page.status {
            root.current-page = root.remembered-power-page;
        }
        root.power-mode = power;
    }
}
