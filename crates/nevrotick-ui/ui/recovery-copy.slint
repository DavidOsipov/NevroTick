import { LocalizationCopy } from "localization-copy.slint";
// Code-owned English copy; no translation data selects actions or resource paths.
export global RecoveryCopy {
    out property <string> title: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[181] : "Date recovery";
    out property <string> description: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[182] : "Recovering a certificate-date basis and changing the Windows clock are separate operations.";
    out property <string> back: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[183] : "Back";
    out property <string> settings-description: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[184] : "Signed-date recovery details and optional, off-default plain-NTP helper previews open in Power user. Back returns to this Settings view and mode.";
    out property <string> context-description: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[185] : "Date-recovery helpers are separate from ordinary synchronization sources and supply no normal-selection votes.";
    out property <string> open-details: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[186] : "Open Date recovery";
    out property <string> leave-title: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[187] : "Leave helper edits?";
    out property <string> leave-description: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[188] : "Keep the raw fields for later, discard unsubmitted edits, or stay here. The retained local preview, active policy and services remain unchanged.";
    out property <string> leave-keep: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[189] : "Keep draft and leave";
    out property <string> leave-discard: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[190] : "Discard edits and leave";
    out property <string> leave-stay: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[191] : "Stay here";
    out property <string> roughtime-title: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[192] : "Roughtime when needed";
    out property <string> roughtime-description: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[193] : "Roughtime supplies a signed approximate date when an incorrect computer date prevents secure NTS checks. Usable retained or strict NTS paths take priority; healthy tracking needs no periodic Roughtime checks.";
    out property <string> no-effect: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[194] : "A signed date alone cannot change your clock. Full NTS verification, fresh source agreement and separate clock authority are still required.";
    out property <string> unavailable: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[195] : "No live recovery evidence is connected in this preview.";
    out property <string> signatures: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[196] : "Signature verification";
    out property <string> date: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[197] : "Accepted approximate date";
    out property <string> handoff: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[198] : "NTS handoff";
    out property <string> unobserved: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[199] : "Not observed";
    out property <string> no-date: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[200] : "No verified date accepted";
    out property <string> show-path: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[201] : "Show recovery path";
    out property <string> hide-path: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[202] : "Hide recovery path";
    out property <string> retained-step: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[203] : "1. Try usable retained or strict NTS paths first.";
    out property <string> date-step: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[204] : "2. When needed, verify Roughtime signatures and admit the approximate-date evidence separately.";
    out property <string> nts-step: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[205] : "3. Verify NTS in isolation, retaining name, trust and revocation checks.";
    out property <string> agreement-step: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[206] : "4. Obtain fresh agreement. Date-recovery sources supply no ordinary synchronization votes.";
    out property <string> authority-step: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[207] : "5. Revalidate clock authority. No preliminary clock change is made.";
    out property <string> helpers-title: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[208] : "Explicit plain-NTP helpers";
    out property <string> helpers-description: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[209] : "Off by default. These optional, unauthenticated helpers supply only a certificate-date hint. They are separate from signed Roughtime, never an automatic fallback, and do not authenticate time or vote in normal time selection.";
    out property <string> one-helper-warning: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[210] : "One helper provides a weaker, unauthenticated date hint.";
    out property <string> two-helper-warning: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[211] : "Both helpers must reply and agree; there is no silent fallback to one. Agreement still does not authenticate the date.";
    out property <string> count-label: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[212] : "Date helpers";
    out property <[string]> counts: LocalizationCopy.value.catalog-ready ? [LocalizationCopy.value.texts[213], LocalizationCopy.value.texts[214], LocalizationCopy.value.texts[215]] : ["Off", "One helper", "Two helpers"];
    out property <string> first-label: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[216] : "First helper identity";
    out property <string> second-label: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[217] : "Second helper identity";
    out property <string> host-help: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[218] : "ASCII hostname or IP address, without a URL, path or spaces. Helpers use NTP port 123.";
    out property <string> preview: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[219] : "Review helper preview";
    out property <string> cancel: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[220] : "Cancel edits";
    out property <string> review-title: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[221] : "Local helper preview";
    out property <string> off: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[222] : "Helpers are off in this preview.";
    out property <string> boundary: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[223] : "This is an in-memory preview. Active policy and services remain unchanged.";
    out property <string> keep-editing: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[224] : "Keep editing";
    out property <string> discard: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[225] : "Discard preview";
    out property <string> apply: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[226] : "Apply helper settings";
    out property <string> apply-unavailable: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[227] : "Applying helper settings requires the installed application's authorized management interface, which is not connected.";
}
