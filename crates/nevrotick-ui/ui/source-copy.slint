import { LocalizationCopy } from "localization-copy.slint";
// Code-owned English source-workflow copy, pending the shared typed catalog.
export global SourceCopy {
    out property <[string]> change-labels: LocalizationCopy.value.catalog-ready ? [LocalizationCopy.value.texts[203], LocalizationCopy.value.texts[204], LocalizationCopy.value.texts[205], LocalizationCopy.value.texts[206]] : ["Baseline", "Add", "Edit", "Remove"];
    out property <string> review-none: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[207] : "None";
    out property <string> profile-value: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[177] : "Local source preview · active policy unchanged";
    out property <string> preview-note: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[178] : "These entries are local candidates. They create no measurements, authenticated observations or votes.";
    out property <string> add-source: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[179] : "Add source preview";
    out property <string> remove-source: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[180] : "Remove preview";
    out property <string> review-changes: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[181] : "Review changes";
    out property <string> review-heading: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[182] : "Preview changes";
    out property <string> review-description: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[183] : "Review the original fixture and the local candidate. No changes have been applied to a service.";
    out property <string> before-label: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[184] : "Original fixture";
    out property <string> after-label: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[185] : "Local preview";
    out property <string> undo: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[186] : "Undo change";
    out property <string> discard: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[187] : "Discard all preview changes";
    out property <string> close-review: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[188] : "Keep editing";
    out property <string> apply: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[189] : "Apply to background service";
    out property <string> apply-unavailable: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[190] : "Apply is unavailable in this fixture. Review and editing affect only this preview session.";
    out property <string> empty-heading: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[191] : "No sources in the local preview";
    out property <string> empty-description: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[192] : "Add a source preview or undo a removal. The original fixture and active service configuration are unchanged.";
    out property <string> empty-review: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[193] : "No preview changes to review.";
    out property <string> add-title: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[194] : "Add a source preview";
    out property <string> edit-title: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[195] : "Edit source preview";
    out property <[string]> protocols: LocalizationCopy.value.catalog-ready ? [LocalizationCopy.value.texts[196], LocalizationCopy.value.texts[197]] : ["NTS (authenticated responses)", "NTP (unauthenticated)"];
    out property <string> protocol-help: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[198] : "Choose the protocol explicitly. Unavailable NTS never switches to plain NTP automatically.";
    out property <string> ntp-warning: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[199] : "Plain NTP does not authenticate the server response. This is an explicit local protocol preview.";
    out property <string> ntp-port: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[200] : "NTP port";
    out property <string> port-help: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[201] : "Decimal port from 1 to 65535. Defaults: NTS-KE 4460; NTP 123. A manually edited port stays unchanged when switching protocol.";
    out property <string> statistics-description: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[202] : "The local source preview contains identities and protocol-specific ports, without offsets, uncertainties or measurement history.";
    out property <string> page-required: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[208] : "Open Sources in Power User mode before changing source previews.";
    out property <string> list-required: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[209] : "Return to the source list before changing source previews.";
    out property <string> review-required: LocalizationCopy.value.catalog-ready ? LocalizationCopy.value.texts[210] : "Open the changes review before undoing or discarding local previews.";
}
