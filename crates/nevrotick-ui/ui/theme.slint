    out property <color> ink: #202b35;
    out property <color> muted: #5b6872;
    out property <color> line: #dce2e5;
    out property <color> surface: #ffffff;
    out property <color> soft: #f7f9fa;
    out property <color> blue: #355e73;
    out property <color> blue-soft: #edf3f6;
    out property <color> green: #275f47;
    out property <color> green-soft: #edf6ef;
    out property <color> amber: #815511;
    out property <color> amber-soft: #fbf5e8;
    out property <color> red: #a2363b;
    out property <color> red-soft: #fbefef;
    out property <color> about-surface: #fbf9f1;
    out property <length> small-gap: 8px;
    out property <length> gap: 16px;
    out property <length> panel-padding: 22px;
    out property <length> radius: 8px;
