<x:xmpmeta xmlns:Iptc4xmpCore="http://iptc.org/std/Iptc4xmpCore/1.0/xmlns/" xmlns:Iptc4xmpExt="http://iptc.org/std/Iptc4xmpExt/2008-02-29/" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:exif="http://ns.adobe.com/exif/1.0/" xmlns:photoshop="http://ns.adobe.com/photoshop/1.0/" xmlns:plus="http://ns.useplus.org/ldf/xmp/1.0/" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:stEvt="http://ns.adobe.com/xap/1.0/sType/ResourceEvent#" xmlns:tiff="http://ns.adobe.com/tiff/1.0/" xmlns:x="adobe:ns:meta/" xmlns:xmp="http://ns.adobe.com/xap/1.0/" xmlns:xmpMM="http://ns.adobe.com/xap/1.0/mm/" xmlns:xmpRights="http://ns.adobe.com/xap/1.0/rights/" x:xmptk="XMP Image Metadata Skill"><rdf:RDF><rdf:Description rdf:about=""><photoshop:Instructions>NevroTick brand artwork: proprietary; all rights reserved. Source code is licensed separately as open source. Contact business@david-osipov.vision for permission to reuse this visual asset.</photoshop:Instructions><photoshop:Headline>NevroTick — monochrome head icon, dark ink</photoshop:Headline><photoshop:Credit>David Osipov</photoshop:Credit><photoshop:ColorMode>3</photoshop:ColorMode><dc:format>image/avif</dc:format><dc:type><rdf:Bag><rdf:li>StillImage</rdf:li></rdf:Bag></dc:type><dc:identifier>urn:uuid:f2d75370-54df-5981-8c7e-ed4db778ed3f</dc:identifier><dc:title><rdf:Alt><rdf:li xml:lang="x-default">NevroTick — monochrome head icon, dark ink — transparent, for light surfaces — 1024 × 1024 px</rdf:li></rdf:Alt></dc:title><dc:subject><rdf:Bag><rdf:li>NevroTick</rdf:li><rdf:li>head icon</rdf:li><rdf:li>monochrome</rdf:li><rdf:li>optical simplification</rdf:li><rdf:li>dark ink</rdf:li><rdf:li>transparent background</rdf:li><rdf:li>for light surfaces</rdf:li><rdf:li>AI-assisted</rdf:li><rdf:li>deterministic rasterization</rdf:li><rdf:li>David Osipov</rdf:li><rdf:li>proprietary brand artwork</rdf:li></rdf:Bag></dc:subject><dc:creator><rdf:Seq><rdf:li>David Osipov</rdf:li></rdf:Seq></dc:creator><dc:rights><rdf:Alt><rdf:li xml:lang="x-default">© David Osipov. All rights reserved.</rdf:li></rdf:Alt></dc:rights><dc:description><rdf:Alt><rdf:li xml:lang="x-default">Optically simplified NevroTick mascot head drawn in a single dark ink, rendered from the existing vector geometry. Prepared for light surfaces; the surrounding canvas is transparent. Created in an AI-assisted code and design workflow from existing vector geometry or outlined typography; author: David Osipov. Derived from the reviewed NevroTick raster kit v1.1. Proprietary NevroTick brand artwork; the application source code is licensed separately as open source.</rdf:li></rdf:Alt></dc:description><Iptc4xmpCore:IntellectualGenre>Icon</Iptc4xmpCore:IntellectualGenre><Iptc4xmpCore:CreatorContactInfo rdf:parseType="Resource"><Iptc4xmpCore:CiAdrCtry>Georgia</Iptc4xmpCore:CiAdrCtry><Iptc4xmpCore:CiAdrCity>Tbilisi</Iptc4xmpCore:CiAdrCity><Iptc4xmpCore:CiEmailWork>business@david-osipov.vision</Iptc4xmpCore:CiEmailWork><Iptc4xmpCore:CiUrlWork>https://david-osipov.vision</Iptc4xmpCore:CiUrlWork></Iptc4xmpCore:CreatorContactInfo><Iptc4xmpCore:AltTextAccessibility><rdf:Alt><rdf:li xml:lang="x-default">A simplified NevroTick mascot head in a single dark color. Transparent surrounding canvas.</rdf:li></rdf:Alt></Iptc4xmpCore:AltTextAccessibility><xmpMM:InstanceID>xmp.iid:b212ca45-eadc-44a9-8141-999a00190151</xmpMM:InstanceID><xmpMM:DocumentID>xmp.did:a9383a6c-853e-43d5-a965-ebcca8dc9539</xmpMM:DocumentID><xmpMM:History><rdf:Seq><rdf:li rdf:parseType="Resource"><stEvt:action>saved</stEvt:action><stEvt:instanceID>xmp.iid:b212ca45-eadc-44a9-8141-999a00190151</stEvt:instanceID><stEvt:when>2026-10-28T19:57:15+00:00</stEvt:when><stEvt:softwareAgent>NevroTick AVIF metadata workflow</stEvt:softwareAgent></rdf:li></rdf:Seq></xmpMM:History><xmpRights:Marked>True</xmpRights:Marked><xmpRights:Owner><rdf:Bag><rdf:li>David Osipov</rdf:li></rdf:Bag></xmpRights:Owner><xmpRights:UsageTerms><rdf:Alt><rdf:li xml:lang="x-default">Proprietary NevroTick brand artwork.