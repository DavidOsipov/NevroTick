<x:xmpmeta xmlns:Iptc4xmpCore="http://iptc.org/std/Iptc4xmpCore/1.0/xmlns/" xmlns:Iptc4xmpExt="http://iptc.org/std/Iptc4xmpExt/2008-02-29/" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:exif="http://ns.adobe.com/exif/1.0/" xmlns:photoshop="http://ns.adobe.com/photoshop/1.0/" xmlns:plus="http://ns.useplus.org/ldf/xmp/1.0/" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:stEvt="http://ns.adobe.com/xap/1.0/sType/ResourceEvent#" xmlns:tiff="http://ns.adobe.com/tiff/1.0/" xmlns:x="adobe:ns:meta/" xmlns:xmp="http://ns.adobe.com/xap/1.0/" xmlns:xmpMM="http://ns.adobe.com/xap/1.0/mm/" xmlns:xmpRights="http://ns.adobe.com/xap/1.0/rights/" x:xmptk="XMP Image Metadata Skill"><rdf:RDF><rdf:Description rdf:about=""><photoshop:Instructions>NevroTick brand artwork: proprietary; all rights reserved. Source code is licensed separately as open source. Contact business@david-osipov.vision for permission to reuse this visual asset.</photoshop:Instructions><photoshop:Headline>NevroTick — portrait head icon</photoshop:Headline><photoshop:Credit>David Osipov</photoshop:Credit><photoshop:ColorMode>3</photoshop:ColorMode><dc:format>image/avif</dc:format><dc:type><rdf:Bag><rdf:li>StillImage</rdf:li></rdf:Bag></dc:type><dc:identifier>urn:uuid:f18e5452-29b6-5540-bc4f-a9cafe33ca01</dc:identifier><dc:title><rdf:Alt><rdf:li xml:lang="x-default">NevroTick — portrait head icon — transparent — 64 × 64 px</rdf:li></rdf:Alt></dc:title><dc:subject><rdf:Bag><rdf:li>NevroTick</rdf:li><rdf:li>mascot head</rdf:li><rdf:li>portrait</rdf:li><rdf:li>icon</rdf:li><rdf:li>reviewed v1.1</rdf:li><rdf:li>transparent background</rdf:li><rdf:li>AI-generated</rdf:li><rdf:li>David Osipov</rdf:li><rdf:li>proprietary brand artwork</rdf:li></rdf:Bag></dc:subject><dc:creator><rdf:Seq><rdf:li>David Osipov</rdf:li></rdf:Seq></dc:creator><dc:rights><rdf:Alt><rdf:li xml:lang="x-default">© David Osipov. All rights reserved.</rdf:li></rdf:Alt></dc:rights><dc:description><rdf:Alt><rdf:li xml:lang="x-default">The reviewed NevroTick mascot head portrait originating from the approved app-icon-concept artwork. This is a size-specific raster export. The surrounding canvas is transparent. Created using generative AI; author: David Osipov. Derived from the reviewed NevroTick raster kit v1.1. Proprietary NevroTick brand artwork; the application source code is licensed separately as open source.</rdf:li></rdf:Alt></dc:description><Iptc4xmpCore:IntellectualGenre>Icon</Iptc4xmpCore:IntellectualGenre><Iptc4xmpCore:CreatorContactInfo rdf:parseType="Resource"><Iptc4xmpCore:CiAdrCtry>Georgia</Iptc4xmpCore:CiAdrCtry><Iptc4xmpCore:CiAdrCity>Tbilisi</Iptc4xmpCore:CiAdrCity><Iptc4xmpCore:CiEmailWork>business@david-osipov.vision</Iptc4xmpCore:CiEmailWork><Iptc4xmpCore:CiUrlWork>https://david-osipov.vision</Iptc4xmpCore:CiUrlWork></Iptc4xmpCore:CreatorContactInfo><Iptc4xmpCore:AltTextAccessibility><rdf:Alt><rdf:li xml:lang="x-default">The anxious NevroTick mascot head with tousled dark hair, a white streak, an angular pale face and a blue collar. Transparent surrounding canvas.</rdf:li></rdf:Alt></Iptc4xmpCore:AltTextAccessibility><xmpMM:InstanceID>xmp.iid:4d5ba019-b5a0-4590-909a-0e53a094f81c</xmpMM:InstanceID><xmpMM:DocumentID>xmp.did:e7392ac7-507e-41fd-95c9-63a2f219c5ec</xmpMM:DocumentID><xmpMM:History><rdf:Seq><rdf:li rdf:parseType="Resource"><stEvt:action>saved</stEvt:action><stEvt:instanceID>xmp.iid:4d5ba019-b5a0-4590-909a-0e53a094f81c</stEvt:instanceID><stEvt:when>2026-10-28T19:58:11+00:00</stEvt:when><stEvt:softwareAgent>NevroTick AVIF metadata workflow</stEvt:softwareAgent></rdf:li></rdf:Seq></xmpMM:History><xmpRights:Marked>True</xmpRights:Marked><xmpRights:Owner><rdf:Bag><rdf:li>David Osipov</rdf:li></rdf:Bag></xmpRights:Owner><xmpRights:UsageTerms><rdf:Alt><rdf:li xml:lang="x-default">Proprietary NevroTick brand artwork. All rights reserved. Permission is required to reproduce or reuse this visual asset. These terms apply to the image and visual brand assets only. NevroTick source c