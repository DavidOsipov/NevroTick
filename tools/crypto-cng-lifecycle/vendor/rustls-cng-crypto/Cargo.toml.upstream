#
# When uploading crates to the registry Cargo will automatically
# "normalize" Cargo.toml files for maximal compatibility
# with all versions of Cargo and also rewrite `path` dependencies
# to registry (e.g., crates.io) dependencies.
#
# If you are reading this file be aware that the original Cargo.toml
# will likely look very different (and much more reasonable).
# See Cargo.toml.orig for the original contents.

[package]
edition = "2021"
name = "rustls-cng-crypto"
version = "0.1.2"
authors = ["Tom Fay <tom@teamfay.co.uk>"]
build = false
autolib = false
autobins = false
autoexamples = false
autotests = false
autobenches = false
description = "Rustls crypto provider for CNG"
homepage = "https://github.com/tofay/rustls-cng-crypto"
readme = "README.md"
license = "MIT"
repository = "https://github.com/tofay/rustls-cng-crypto"

[package.metadata.docs.rs]
default-target = "x86_64-pc-windows-msvc"

[features]
default = ["tls12"]
fips = []
tls12 = ["rustls/tls12"]

[lib]
name = "rustls_cng_crypto"
path = "src/lib.rs"

[[test]]
name = "it"
path = "tests/it.rs"

[[test]]
name = "server"
path = "tests/server.rs"

[dependencies.once_cell]
version = "1.8.0"

[dependencies.pkcs1]
version = "0.7.5"
features = ["std"]

[dependencies.pkcs8]
version = "0.10.2"

[dependencies.rustls]
version = "0.23.20"
features = ["std"]
default-features = false

[dependencies.sec1]
version = "0.7.3"

[dependencies.windows]
version = "0.61.3"
features = [
    "Win32_Security_Cryptography",
    "Win32_System_WinRT",
]

[dependencies.zeroize]
version = "1.8.1"

[dev-dependencies.aws-lc-rs]
version = "1.11.1"
features = ["prebuilt-nasm"]

[dev-dependencies.hex]
version = "0.4.3"

[dev-dependencies.rcgen]
version = "0.14.1"
features = [
    "crypto",
    "aws_lc_rs",
    "pem",
]
default-features = false

[dev-dependencies.rstest]
version = "0.26.1"

[dev-dependencies.rustls]
version = "0.23.0"
features = ["aws-lc-rs"]
default-features = false

[dev-dependencies.rustls-pemfile]
version = "2"

[dev-dependencies.rustls-webpki]
version = "0.103.0"
default-features = false

[dev-dependencies.webpki-roots]
version = "1.0"

[dev-dependencies.wycheproof]
version = "0.6.0"
features = [
    "aead",
    "ecdsa",
    "ecdh",
    "hkdf",
    "mac",
    "rsa_sig",
    "xdh",
]
default-features = false
