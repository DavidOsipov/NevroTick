+/// Constructed only by complete, bounded decoding and duplicate rejection.
+/// Original-map membership remains contextual and is checked by `refine_targets`.
+struct CheckedVtableRefinements(Vec<(String, Vec<String>)>);
+
+fn decode_vtable_refinements(bytes: &[u8]) -> Result<CheckedVtableRefinements> {
+    ensure!(bytes.len() <= MAX_REFINEMENT_BYTES, "refinement document exceeds 256 KiB");
+    let RefinementObject(document): RefinementObject<VtableRefinementDocument> =
+        serde_json::from_slice(bytes).context("invalid vtable target refinement document")?;
+    ensure!(document.version == 1, "unsupported vtable target refinement version");
+    let mut sites = BTreeSet::new();
+    let mut refinements = Vec::new();
+    for RefinementObject(entry) in document.refinements.0 {
+        ensure!(sites.insert(entry.callsite.0.clone()), "duplicate refinement callsite");
+        let mut unique_targets = BTreeSet::new();
+        let mut targets = Vec::new();
+        for target in entry.targets.0 {
+            ensure!(unique_targets.insert(target.0.clone()), "duplicate refinement target");
+            targets.push(target.0);
+        }
+        refinements.push((entry.callsite.0, targets));
+    }
+    Ok(CheckedVtableRefinements(refinements))
+}
+
+/// Return a complete map with only the requested nonempty subsets replaced.
+/// No original map is mutated, including on a later entry's rejection.
+fn refine_targets(
+    original: &BTreeMap<String, Vec<String>>,
+    requested: CheckedVtableRefinements,
+) -> Result<BTreeMap<String, Vec<String>>> {
+    for (site, targets) in &requested.0 {
+        let choices = original.get(site).context("unknown refinement callsite")?;
+        ensure!(targets.iter().all(|target| choices.contains(target)),
+            "refinement contains a target outside its original callsite choices");
+    }
+    let mut refined = original.clone();
+    for (site, targets) in requested.0 {
+        refined.insert(site, targets);
+    }
+    Ok(refined)
+}
