+/// An exact generated name, with a nonempty, bounded UTF-8 representation.
+struct RefinementName(String);
+
+impl<'de> Deserialize<'de> for RefinementName {
+    fn deserialize<D: serde::Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        struct NameVisitor;
+        impl Visitor<'_> for NameVisitor {
+            type Value = RefinementName;
+
+            fn expecting(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+                f.write_str("a nonempty generated name of at most 1024 UTF-8 bytes")
+            }
+
+            fn visit_str<E: serde::de::Error>(self, value: &str) -> Result<Self::Value, E> {
+                if value.is_empty() || value.len() > MAX_REFINEMENT_NAME_BYTES {
+                    return Err(E::custom("refinement name is empty or exceeds its byte limit"));
+                }
+                Ok(RefinementName(value.to_owned()))
+            }
+        }
+        deserializer.deserialize_str(NameVisitor)
+    }
+}
+
+/// Count both request entries and targets during decoding, without trusting a
+/// sequence size hint. The outer byte limit also bounds parser scratch storage.
+struct RefinementItems<T>(Vec<T>);
+
+impl<'de, T: Deserialize<'de>> Deserialize<'de> for RefinementItems<T> {
+    fn deserialize<D: serde::Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        struct ItemsVisitor<T>(PhantomData<T>);
+        impl<'de, T: Deserialize<'de>> Visitor<'de> for ItemsVisitor<T> {
+            type Value = RefinementItems<T>;
+
+            fn expecting(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+                f.write_str("a nonempty array of at most 64 refinement items")
+            }
+
+            fn visit_seq<A: SeqAccess<'de>>(self, mut sequence: A) -> Result<Self::Value, A::Error> {
+                let mut values = Vec::new();
+                while values.len() < MAX_REFINEMENT_ITEMS {
+                    match sequence.next_element()? {
+                        Some(value) => values.push(value),
+                        None if values.is_empty() => {
+                            return Err(serde::de::Error::custom("empty refinement array"));
+                        }
+                        None => return Ok(RefinementItems(values)),
+                    }
+                }
+                if sequence.next_element::<IgnoredAny>()?.is_some() {
+                    return Err(serde::de::Error::custom("refinement array exceeds 64 items"));
+                }
+                Ok(RefinementItems(values))
+            }
+        }
+        deserializer.deserialize_seq(ItemsVisitor(PhantomData))
+    }
+}
