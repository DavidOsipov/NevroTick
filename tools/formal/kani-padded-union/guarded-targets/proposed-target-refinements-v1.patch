+/// Read one regular-file handle once, with a hard byte limit before decoding.
+/// The caller owns/seals input paths; this is not a hostile-filesystem protocol.
+fn read_refinement_input(path: &Path, limit: usize) -> Result<Vec<u8>> {
+    ensure!(std::fs::symlink_metadata(path)?.is_file(), "refinement input is not a regular file");
+    let file = File::open(path)?;
+    ensure!(file.metadata()?.is_file(), "opened refinement input is not a regular file");
+    let mut bytes = Vec::new();
+    file.take((limit + 1) as u64).read_to_end(&mut bytes)?;
+    ensure!(bytes.len() <= limit, "refinement input exceeds its byte limit");
+    Ok(bytes)
+}
+
+/// Fresh artifacts never replace the original map, the supplied path or an
+/// earlier receipt. Failed writes abort before goto-instrument is invoked.
+fn write_refinement_artifact(path: &Path, bytes: &[u8]) -> Result<()> {
+    let mut file = File::options().write(true).create_new(true).open(path)?;
+    file.write_all(bytes)?;
+    file.flush()?;
+    Ok(())
+}
+
+/// Prepare the complete checked map and retain the exact consumed request.
+/// Requires fresh, distinct output paths in the owned model output directory.
+/// This changes neither function bodies nor assertions: the existing guarded
+/// CBMC restriction transformation remains the sole model transformer.
+pub(crate) fn write_refined_vtable_restrictions(
+    original_path: &Path,
+    request_path: &Path,
+    snapshot_path: &Path,
+    refined_path: &Path,
+) -> Result<()> {
+    ensure!(original_path != snapshot_path && original_path != refined_path
+        && request_path != snapshot_path && request_path != refined_path
+        && snapshot_path != refined_path, "refinement artifact paths overlap");
+    let request_bytes = read_refinement_input(request_path, MAX_REFINEMENT_BYTES)?;
+    let requested = decode_vtable_refinements(&request_bytes)?;
+    let original_bytes = read_refinement_input(original_path, MAX_LINKED_RESTRICTION_BYTES)?;
+    let original = serde_json::from_slice(&original_bytes)?;
+    let refined = refine_targets(&original, requested)?;
+    let refined_bytes = serde_json::to_vec(&refined)?;
+    ensure!(refined_bytes.len() <= MAX_LINKED_RESTRICTION_BYTES,
+        "refined map exceeds its byte limit");
+    write_refinement_artifact(snapshot_path, &request_bytes)?;
+    write_refinement_artifact(refined_path, &refined_bytes)
+}
 
