+#[test]
+fn test_verification_export_preserves_raw_fallback_and_recursion_ids() {
+    let harness = HarnessMetadata {
+        pretty_name: "crate::identity_harness".to_string(),
+        mangled_name: "identity_harness".to_string(),
+        crate_name: "sample_crate".to_string(),
+        original_file: "src/lib.rs".to_string(),
+        original_start_line: 1,
+        original_end_line: 2,
+        goto_file: None,
+        attributes: HarnessAttributes::new(HarnessKind::Proof),
+        contract: None,
+        has_loop_contracts: false,
+        is_automatically_generated: false,
+        is_bounded: false,
+        is_ctor_based: false,
+    };
+    let raw_ids = [
+        "_RNvCsjGD3dMRtdCH_8controls13selected_call.1",
+        "assertion.01",
+        ".recursion",
+    ];
+    let properties = raw_ids
+        .iter()
+        .map(|raw| Property {
+            property_id: serde_json::from_value(serde_json::json!(raw)).unwrap(),
+            status: CheckStatus::Success,
+            description: "identity survives normalized presentation".to_string(),
+            source_location: SourceLocation {
+                file: None,
+                function: None,
+                line: None,
+                column: None,
+            },
+            reach: None,
+            trace: None,
+        })
+        .collect();
+    let harness_result = HarnessResult {
+        harness: &harness,
+        result: VerificationResult {
+            status: VerificationStatus::Success,
+            failed_properties: FailedProperties::None,
+            results: Ok(properties),
+            runtime: Duration::from_millis(1),
+            generated_concrete_test: false,
+            ignored_quantifiers: 0,
+            coverage_results: None,
+            cbmc_stats: None,
+        },
+    };
+    let value = create_verification_result_json(&harness_result);
+    for (index, raw) in raw_ids.iter().enumerate() {
+        assert_eq!(value["checks"][index]["id"], index + 1);
+        assert_eq!(value["checks"][index]["raw_property_id"].as_str(), Some(*raw));
+        assert_eq!(value["checks"][index]["status"], "Success");
+    }
+    assert_eq!(value["checks"][0]["function"], "controls::selected_call");
+    assert_eq!(value["checks"][0]["category"], "missing_definition");
+    assert_eq!(value["checks"][1]["category"], "assertion");
+    assert_eq!(value["checks"][2]["category"], "recursion");
 }
 
